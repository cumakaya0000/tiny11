<Window x:Class="NexusPC.Desktop.LocalAiWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXUS PC · Yerel AI" Height="660" Width="900" MinHeight="560" MinWidth="760" WindowStartupLocation="CenterOwner" Background="#0A0A0D" Foreground="#F4F2F4">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="YEREL AI / OLLAMA" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><TextBlock Text="Modellerin, senin bilgisayarında." FontSize="25" FontWeight="SemiBold" Margin="0,7,0,4"/><TextBlock x:Name="ConnectionText" Text="Yerel API kontrol ediliyor…" Foreground="#A29BA4"/></StackPanel>
  <Border Grid.Row="1" Background="#171418" BorderBrush="#33252C" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,20,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MODEL KİTAPLIĞI" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><TextBlock Text="Yüklü modeller" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="⟳   Yenile" Click="Refresh_Click" VerticalAlignment="Center"/></Grid></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <Border Background="#111014" BorderBrush="#27242B" BorderThickness="1" CornerRadius="12" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="Yeni model indir" Foreground="#A29BA4" FontSize="11"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ModelNameBox" Text="qwen3:4b" Padding="10" Background="#19171C" Foreground="White" BorderBrush="#39323A"/><Button Grid.Column="1" Content="İndir" Margin="8,0,0,0" Click="Pull_Click"/></Grid><TextBlock x:Name="PullStatus" Text="İndirme başlamadan önce model boyutunu ve lisansını kontrol et." TextWrapping="Wrap" Foreground="#A29BA4" Margin="0,8,0,0"/><Button x:Name="CancelButton" Content="İndirmeyi iptal et" Visibility="Collapsed" HorizontalContentAlignment="Center" Margin="0,8,0,0" Click="Cancel_Click"/></StackPanel>
    <ListBox x:Name="ModelsList" Background="Transparent" BorderThickness="0" Foreground="#F4F2F4" SelectionChanged="ModelsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#27242B" BorderThickness="0,0,0,1" Padding="8"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding SizeText}" Foreground="#A29BA4" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   <Border Grid.Column="2" Background="#111014" BorderBrush="#27242B" BorderThickness="1" CornerRadius="12" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock Text="Modeli kaldır" Foreground="#A29BA4" FontSize="11"/><Button Content="Seçili modeli kaldır…" Margin="0,6,0,0" Click="Delete_Click"/></StackPanel><StackPanel><TextBlock Text="MODEL TESTİ" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><TextBlock Text="Yerel sohbet" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,10"/><TextBlock x:Name="SelectedModelText" Text="Önce bir model seç." Foreground="#A29BA4" FontSize="11" Margin="0,0,0,8"/><DockPanel Margin="0,0,0,8"><TextBlock Text="Model bellekte: " VerticalAlignment="Center" Foreground="#A29BA4" FontSize="10"/><Button x:Name="KeepAliveButton" Content="5 dakika ▾" Tag="5m" Padding="8,4" Click="KeepAlive_Click"/></DockPanel><TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Padding="9" Background="#19171C" Foreground="White" BorderBrush="#39323A"/><Button x:Name="ChatButton" Content="Yerelde dene" HorizontalContentAlignment="Center" Margin="0,8,0,8" Click="Chat_Click"/><Button x:Name="CancelChatButton" Content="Yanıtı iptal et" Visibility="Collapsed" Margin="0,0,0,8" Click="CancelChat_Click"/><TextBox x:Name="AnswerBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#19171C" Foreground="#D4CDD3" BorderBrush="#27242B" Padding="10"/><Button Content="Bu modelin sohbet geçmişini temizle…" Margin="0,8,0,0" Click="ClearHistory_Click"/></StackPanel></DockPanel></Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="Bağlantı yalnızca bu bilgisayardaki Ollama API'sine yapılır. İnternet yalnızca Ollama/model indirme için gerekir." Foreground="#817984" FontSize="10" Margin="2,12,0,0"/>
 </Grid>
</Window>
