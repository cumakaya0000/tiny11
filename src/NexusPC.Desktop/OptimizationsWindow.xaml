<Window x:Class="NexusPC.Desktop.OptimizationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXUS PC · Optimizasyonlar" Height="740" Width="940" MinHeight="620" MinWidth="780" WindowStartupLocation="CenterOwner" Background="#0A0A0D" Foreground="#F4F2F4">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OPTİMİZASYONLAR / KULLANICI AYARLARI" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><TextBlock Text="Değişiklikleri sen seç." FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Her işlem geri alınabilir ve yalnızca bu Windows hesabını etkiler." Foreground="#A29BA4" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Yedekleri yenile" VerticalAlignment="Center" Click="Refresh_Click"/></Grid>
  <ItemsControl x:Name="OptionsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#151216" BorderBrush="#30272E" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#A29BA4" Margin="0,6,12,0"/><TextBlock Text="{Binding AffectedSettingsSummary, StringFormat='Yedeklenecek ayarlar: {0}'}" TextWrapping="Wrap" Foreground="#817984" FontSize="10" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Tag="{Binding Id}" Content="Önizle ve uygula" VerticalAlignment="Center" Click="Apply_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Border Background="#111014" BorderBrush="#27242B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,8,0,0"><StackPanel><TextBlock Text="GERİ ALMA KAYITLARI" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><TextBlock Text="NEXUS PC bu kullanıcı hesabındaki önceki kayıt değerlerini saklar." Foreground="#A29BA4" FontSize="11" Margin="0,5,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ListBox x:Name="BackupsList" Background="#19171C" Foreground="#F4F2F4" BorderBrush="#30272E" Padding="5"/><Button Grid.Column="1" Content="Seçili yedeği geri yükle" Margin="10,0,0,0" VerticalAlignment="Top" Click="Restore_Click"/></Grid><TextBlock x:Name="StatusText" Text="" Foreground="#A29BA4" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
  <TextBlock Text="Bu sürüm yalnızca açıkça listelenen kullanıcı ayarlarını değiştirir. Sistem geneli veya yönetici yetkisi gerektiren işlemler burada çalıştırılmaz." Foreground="#817984" FontSize="10" TextWrapping="Wrap" Margin="2,12,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
