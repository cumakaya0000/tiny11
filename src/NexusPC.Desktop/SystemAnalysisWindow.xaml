<Window x:Class="NexusPC.Desktop.SystemAnalysisWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXUS PC · Sistem Analizi" Height="640" Width="840" MinHeight="540" MinWidth="680" WindowStartupLocation="CenterOwner" Background="#0A0A0D" Foreground="#F4F2F4">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SİSTEM ANALİZİ" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><TextBlock Text="Donanımına genel bakış." FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="⟳   Yenile" VerticalAlignment="Center" Click="Refresh_Click"/></Grid>
  <UniformGrid Columns="2"><Border Background="#171418" BorderBrush="#33252C" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,8"><StackPanel><TextBlock Text="İŞLEMCİ" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CpuValue" Text="—" TextWrapping="Wrap" FontSize="16" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#171418" BorderBrush="#33252C" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,8"><StackPanel><TextBlock Text="BELLEK" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RamValue" Text="—" FontSize="16" Margin="0,8,0,0"/><TextBlock x:Name="RamDetail" Text="—" Foreground="#A29BA4" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></UniformGrid>
  <Border Background="#111014" BorderBrush="#27242B" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10"><StackPanel><TextBlock Text="GRAFİKSKARTLAR" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><ItemsControl x:Name="GpuList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,3,0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  <Border Background="#111014" BorderBrush="#27242B" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="SABİT SÜRÜCÜLER" Foreground="#E95B84" FontSize="10" FontWeight="Bold"/><ItemsControl x:Name="DiskList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding FreeText}" Foreground="#A29BA4"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  <TextBlock Text="Bu ekran sistem bilgilerini okur; Windows ayarlarında değişiklik yapmaz." Foreground="#817984" FontSize="10" Margin="2,12,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
